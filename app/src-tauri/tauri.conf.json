{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PowerBench",
  "version": "1.0.0",
  "identifier": "ru.pekushh.powerbench",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../build-ui"
  },
  "app": {
    "windows": [
      {
        "title": "PowerBench",
        "label": "main",
        "width": 1200,
        "height": 800,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}