{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PowerBench",
  "version": "1.1.0",
  "identifier": "ru.pekushh.powerbench",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build-ui"
  },
  "app": {
    "windows": [
      {
      "title": "PowerBench",
      "label": "main",
      "width": 1200,
      "height": 800,
      "minWidth": 1000,
      "minHeight": 680,
      "resizable": true,
      "maximizable": true,
      "fullscreen": false,
      "center": true,
      "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
